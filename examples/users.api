BASE "http://localhost:8000";

TEST "List users and open the first one" {
    GET "/users";
    EXPECT STATUS 200;
    EXPECT JSON "count" == 2;
    SAVE first_id = JSON "items.0.id";

    GET "/users/" + first_id;
    EXPECT STATUS 200;
    EXPECT JSON "name" == "Alice";
    EXPECT JSON "tags.0" == "admin";
}

TEST "Create, read, rename and delete a user" {
    POST "/users" BODY { "name": "Carol" };
    EXPECT STATUS 201;
    SAVE new_id = JSON "id";

    GET "/users/" + new_id;
    EXPECT STATUS 200;
    EXPECT JSON "name" == "Carol";

    PUT "/users/" + new_id BODY { "name": "Caroline" };
    EXPECT STATUS 200;
    EXPECT JSON "name" == "Caroline";

    DELETE "/users/" + new_id;
    EXPECT STATUS 204;

    GET "/users/" + new_id;
    EXPECT STATUS 404;
    EXPECT JSON "error" == "user not found";
}
